# Secrets — niemals committen
.env
video-use/.env
web/.env.local

# Dependencies
node_modules/
__pycache__/
.venv/
video-use/.venv/
web/node_modules/
web/.next/

# Rohvideos
raw/*.mp4
raw/*.mov
raw/*.mkv
raw/**/*.mp4
raw/**/*.mov
raw/**/*.mkv

# Projekt-Outputs -- Kunden-Content, nie committen. Blanket-Ausschluss statt
# einzelner Dateiendungen (traf z.B. keine .ttf/.txt-Hilfsdateien) -- nur die
# Ordnerstruktur bleibt via .gitkeep erhalten.
projects/*/renders/*
projects/*/previews/*
projects/*/transcripts/*
projects/*/clips/*
projects/*/assets/*
projects/*/_bundle_assets/
!projects/*/renders/.gitkeep
!projects/*/previews/.gitkeep
!projects/*/transcripts/.gitkeep
!projects/*/clips/.gitkeep
!projects/*/assets/.gitkeep

# Lose Arbeitsdateien direkt unter projects/<name>/ (EDL, gepacktes Transkript,
# Claude-Design-Transkript-Export) -- ebenfalls Kunden-Content, nie committen.
projects/*/edl.json
projects/*/takes_packed.md
projects/*/output_transcript.md
projects/*/output_transcript.json

# Worker-Checkpoint-Transportdateien (siehe worker/src/checkpointHook.ts) --
# reine Steuerdateien, kein Projekt-Inhalt.
.worker_checkpoints/

# Caches
.hyperframes-cache/

# OS
.DS_Store
Thumbs.db

# Skill-Junctions -- reproduzierbar per Setup (npm install + Junction-Erstellung),
# kein echter Inhalt, sonst dupliziert Git node_modules/video-use komplett
.claude/skills/

# Lokaler Harness-State, kein Projekt-Inhalt
.claude/scheduled_tasks.lock
