# Eigener Anthropic-API-Key (platform.claude.com, Pay-as-you-go) --
# NICHT dasselbe wie ein Claude-Code-Abo-Login. Jeder gestartete Auftrag
# verbraucht ab dem ersten Checkpoint automatisch echtes Kontingent.
ANTHROPIC_API_KEY=

# Supabase Project Settings -> API.
SUPABASE_URL=https://xgmuzuxtezefhblezque.supabase.co

# service_role Key -- NICHT der anon Key aus web/.env.local. Umgeht RLS,
# bleibt lokal, landet nie in web/ oder NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Wie oft der Worker nach neuen Auftraegen / Checkpoint-Freigaben pollt.
POLL_INTERVAL_MS=5000
